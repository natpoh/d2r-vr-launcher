// launcher.rc - D2RVRLauncher.exe's resources: icon, pictures, manifest, version. One exe, no asset folder.
#include <windows.h>

#include "resource.h"
#include "gui_version.h"      // generated by CMake from kLauncherVersion (src/util.h)

// the lowest icon id is the exe's icon in Explorer
IDI_APP ICON "../assets/launcher_icon.ico"

IDB_LOGO PNG "../assets/launcher_icon_256.png"
IDB_AUTHENTIC PNG "../assets/authentic_crystal_icon_128.png"
IDB_UNLEASHED PNG "../assets/unleashed_icon_128.png"

// the application manifest: common controls 6, per-monitor DPI v2, UTF-8, no elevation (the linker's own manifest is switched off)
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "launcher.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION VRML_VER_COMMA
 PRODUCTVERSION VRML_VER_COMMA
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "D2R VR Launcher"
            VALUE "FileVersion", VRML_VER_TEXT
            VALUE "InternalName", "D2RVRLauncher"
            VALUE "OriginalFilename", "D2RVRLauncher.exe"
            VALUE "ProductName", "D2R VR Launcher"
            VALUE "ProductVersion", VRML_VER_TEXT
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
